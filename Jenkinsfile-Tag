// ============================================================
//  PIPELINE 3 : BUILD VERSIONNÉ SUR TAG (vX.Y.Z)
//  Déclencheur : Push d'un tag Git (ex: v1.0.0, v1.1.0) ou build manuel
//  Objectif    : Produire les images Docker officielles de release,
//                valider le smoke test et archiver le manifeste officiel
// ============================================================

pipeline {
    agent any

    parameters {
        string(
            name: 'RELEASE_TAG',
            defaultValue: 'v1.1.0',
            description: 'Tag de release versionné (format sémantique obligatoire vX.Y.Z)'
        )
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        DOCKER_BIN     = 'C:\\Users\\Famory Toure\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        IMAGE_BASE     = 'biwex-store'
        // Priorité : tag injecté par webhook Jenkins > paramètre de build > fallback
        EFFECTIVE_TAG  = "${env.TAG_NAME ?: params.RELEASE_TAG ?: 'v1.1.0'}"
        CONTAINER_NAME = "biwex-release-val-${BUILD_NUMBER}"
        SMOKE_STATUS   = 'NOT_RUN'
    }

    stages {

        // ══════════════════════════════════════════════════════
        // STAGE 1 - CHECKOUT
        // ══════════════════════════════════════════════════════
        stage('1 - Checkout') {
            steps {
                echo "=== STAGE 1 : Checkout du code au tag de release [${env.EFFECTIVE_TAG}] ==="
                checkout scm
                script {
                    echo "Tag de release : ${env.EFFECTIVE_TAG}"
                    echo "Build Jenkins  : #${env.BUILD_NUMBER}"
                }
            }
        }

        // ══════════════════════════════════════════════════════
        // STAGE 2 - SETUP & CONFORMITÉ SEMVER
        // ══════════════════════════════════════════════════════
        stage('2 - Setup') {
            steps {
                echo '=== STAGE 2 : Contrôle de conformité du versioning sémantique ==='
                script {
                    // Validation du format vX.Y.Z en Groovy (sans risque d'erreur cmd.exe)
                    def semverPattern = ~/^v\d+\.\d+\.\d+$/
                    if (!(env.EFFECTIVE_TAG ==~ semverPattern)) {
                        error("ERREUR DE VERSIONING : Le tag '${env.EFFECTIVE_TAG}' ne respecte pas le format sémantique vX.Y.Z (exemples: v1.0.0, v1.1.0) !")
                    }
                    echo "[SemVer OK] Le tag '${env.EFFECTIVE_TAG}' est strictement conforme au versioning sémantique."
                }

                bat '''
                    @echo off
                    echo [Setup] Verification de l arborescence de release...
                    if not exist app.py exit /b 1
                    if not exist requirements.txt exit /b 1
                    if not exist Dockerfile exit /b 1
                    if not exist scripts\\smoke_test.py exit /b 1

                    if not exist artifacts mkdir artifacts
                    if not exist artifacts\\release mkdir artifacts\\release

                    echo [Setup] Moteur Docker :
                    if exist "%DOCKER_BIN%" (
                        "%DOCKER_BIN%" version
                    ) else (
                        docker version
                    )
                '''
            }
        }

        // ══════════════════════════════════════════════════════
        // STAGE 3 - BUILD VERSIONNÉ PARALLÈLE
        // ══════════════════════════════════════════════════════
        stage('3 - Build Docker Versionné (Parallèle)') {
            parallel {

                stage('Build Production (Python 3.11 + latest)') {
                    steps {
                        echo "=== Construction Image Officielle Production [${env.EFFECTIVE_TAG}-py311] ==="
                        bat '''
                            @echo off
                            set "DOCKER_CMD=%DOCKER_BIN%"
                            if not exist "%DOCKER_CMD%" set "DOCKER_CMD=docker"

                            echo [Build] Tagging %IMAGE_BASE%:%EFFECTIVE_TAG%-py311 et %IMAGE_BASE%:latest...
                            "%DOCKER_CMD%" build ^
                                --build-arg PYTHON_VERSION=3.11 ^
                                --label "version=%EFFECTIVE_TAG%" ^
                                --label "build=%BUILD_NUMBER%" ^
                                --label "role=production" ^
                                -t %IMAGE_BASE%:%EFFECTIVE_TAG%-py311 ^
                                -t %IMAGE_BASE%:latest ^
                                . > artifacts\\release\\docker-build-py311.log 2>&1

                            set "BUILD_EXIT=%ERRORLEVEL%"
                            type artifacts\\release\\docker-build-py311.log
                            exit /b %BUILD_EXIT%
                        '''
                    }
                }

                stage('Build Compatibilité (Python 3.12)') {
                    steps {
                        echo "=== Construction Image Compatibilité [${env.EFFECTIVE_TAG}-py312] ==="
                        bat '''
                            @echo off
                            set "DOCKER_CMD=%DOCKER_BIN%"
                            if not exist "%DOCKER_CMD%" set "DOCKER_CMD=docker"

                            echo [Build] Tagging %IMAGE_BASE%:%EFFECTIVE_TAG%-py312...
                            "%DOCKER_CMD%" build ^
                                --build-arg PYTHON_VERSION=3.12 ^
                                --label "version=%EFFECTIVE_TAG%" ^
                                --label "build=%BUILD_NUMBER%" ^
                                --label "role=compatibility" ^
                                -t %IMAGE_BASE%:%EFFECTIVE_TAG%-py312 ^
                                . > artifacts\\release\\docker-build-py312.log 2>&1

                            set "BUILD_EXIT=%ERRORLEVEL%"
                            type artifacts\\release\\docker-build-py312.log
                            exit /b %BUILD_EXIT%
                        '''
                    }
                }
            }
        }

        // ══════════════════════════════════════════════════════
        // STAGE 4 - RUN DOCKER (Validation image Release)
        // ══════════════════════════════════════════════════════
        stage('4 - Run Docker') {
            steps {
                echo '=== STAGE 4 : Démarrage conteneur de qualification release ==='
                bat '''
                    @echo off
                    set "DOCKER_CMD=%DOCKER_BIN%"
                    if not exist "%DOCKER_CMD%" set "DOCKER_CMD=docker"

                    echo [Run] Arret de tout ancien conteneur...
                    "%DOCKER_CMD%" rm -f %CONTAINER_NAME% 2>NUL

                    echo [Run] Demarrage du conteneur de release %CONTAINER_NAME%...
                    "%DOCKER_CMD%" run -d ^
                        --name %CONTAINER_NAME% ^
                        -e SECRET_KEY=jenkins-release-production-key ^
                        %IMAGE_BASE%:%EFFECTIVE_TAG%-py311

                    if errorlevel 1 (
                        echo ERREUR : Echec du demarrage du conteneur de release.
                        exit /b 1
                    )

                    echo [Run] Conteneur de qualification pret.
                    "%DOCKER_CMD%" ps --filter name=%CONTAINER_NAME%
                '''
                sleep(time: 5, unit: 'SECONDS')
            }
        }

        // ══════════════════════════════════════════════════════
        // STAGE 5 - SMOKE TEST (Qualification Release)
        // ══════════════════════════════════════════════════════
        stage('5 - Smoke Test') {
            steps {
                echo '=== STAGE 5 : Smoke Test d homologation release ==='
                script {
                    try {
                        retry(20) {
                            sleep(time: 2, unit: 'SECONDS')
                            bat '''
                                @echo off
                                set "DOCKER_CMD=%DOCKER_BIN%"
                                if not exist "%DOCKER_CMD%" set "DOCKER_CMD=docker"

                                "%DOCKER_CMD%" exec %CONTAINER_NAME% python /app/scripts/smoke_test.py http://127.0.0.1:5000/ > artifacts\\release\\smoke-test.txt 2>&1
                                type artifacts\\release\\smoke-test.txt
                            '''
                        }

                        env.SMOKE_STATUS = 'PASSED'
                        writeFile(file: 'artifacts/release/smoke-status.txt', text: 'PASSED')
                        echo '=== QUALIFICATION RELEASE : PASSED ==='

                    } catch (err) {
                        env.SMOKE_STATUS = 'FAILED'
                        writeFile(file: 'artifacts/release/smoke-status.txt', text: 'FAILED')
                        echo '=== QUALIFICATION RELEASE : FAILED ==='
                        throw err
                    }
                }
            }
        }

        // ══════════════════════════════════════════════════════
        // STAGE 6 - ARCHIVE ARTIFACTS (Manifeste & Rapport)
        // ══════════════════════════════════════════════════════
        stage('6 - Archive Artifacts') {
            steps {
                echo '=== STAGE 6 : Archivage officiel de la release et du manifeste ==='
                script {
                    def smokeResult = fileExists('artifacts/release/smoke-status.txt') ? readFile('artifacts/release/smoke-status.txt').trim() : 'UNKNOWN'

                    def manifest = """\
==============================================================
 MANIFESTE OFFICIEL DE RELEASE — BIWEX STORE [${env.EFFECTIVE_TAG}]
==============================================================
Version Publiee   : ${env.EFFECTIVE_TAG}
Date de Release   : ${new Date().format('dd/MM/yyyy HH:mm:ss')}
Build Jenkins     : #${env.BUILD_NUMBER}
Commit Git        : ${env.GIT_COMMIT ?: 'N/A'}

IMAGES OFFICIELLES HOMOLOGUEES :
  - ${env.IMAGE_BASE}:${env.EFFECTIVE_TAG}-py311  (Image Production)
  - ${env.IMAGE_BASE}:${env.EFFECTIVE_TAG}-py312  (Image Compatibilite)
  - ${env.IMAGE_BASE}:latest                      (Pointeur derniere version stable)

QUALIFICATION :
  Smoke Test Homologation : ${smokeResult}

ARTEFACTS SCELLES :
  - artifacts/release/docker-build-py311.log
  - artifacts/release/docker-build-py312.log
  - artifacts/release/smoke-test.txt
  - artifacts/release/smoke-status.txt
  - artifacts/release/release-manifest.txt
  - artifacts/release/pipeline-report.txt

STATUT DE HOMOLOGATION : CONFORME POUR DEPLOIEMENT EN PRODUCTION

Binôme : Famory TOURE & Abdoul TRAORE
Module DevOps 3LIG - ISG Sousse
==============================================================
"""
                    writeFile(file: 'artifacts/release/release-manifest.txt', text: manifest)
                    writeFile(file: 'artifacts/release/pipeline-report.txt', text: manifest)
                    echo manifest
                }

                archiveArtifacts(
                    artifacts: 'artifacts/**',
                    fingerprint: true,
                    allowEmptyArchive: true
                )
            }
        }
    }

    // ── POST ACTIONS ────────────────────────────────────────────
    post {
        always {
            echo '=== Nettoyage conteneur de qualification release ==='
            bat '''
                @echo off
                set "DOCKER_CMD=%DOCKER_BIN%"
                if not exist "%DOCKER_CMD%" set "DOCKER_CMD=docker"

                echo [Cleanup] Suppression du conteneur de qualification...
                "%DOCKER_CMD%" rm -f %CONTAINER_NAME% 2>NUL

                echo [Note] Les images de release %IMAGE_BASE%:%EFFECTIVE_TAG%-py311 et :latest sont conservees.
                exit /b 0
            '''
        }
        success {
            echo "BIWEX STORE : Release officielle ${env.EFFECTIVE_TAG} generee avec SUCCES."
        }
        failure {
            echo "BIWEX STORE : Echec de generation de la release ${env.EFFECTIVE_TAG}."
        }
    }
}
