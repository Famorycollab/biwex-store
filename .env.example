# ============================================================
#  VARIABLES D'ENVIRONNEMENT — BIWEX STORE
#
#  Ce fichier est un EXEMPLE (.env.example).
#  Copiez-le en .env et remplissez les valeurs :
#    cp .env.example .env
#
#  Le fichier .env est IGNORÉ par Git (.gitignore)
#  → les secrets ne sont jamais versionnés
#
#  En production (Docker/Jenkins), ces valeurs sont passées
#  via -e dans la commande docker run :
#    docker run -e SECRET_KEY=... -e DATABASE_URL=... biwex-store
# ============================================================

# ── FLASK ────────────────────────────────────────────────────
# Clé secrète pour la signature des sessions et cookies
# → Générer une clé sécurisée : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi-en-production

# ── BASE DE DONNÉES ─────────────────────────────────────────
# SQLite (développement local) :
DATABASE_URL=sqlite:///biwex.db

# PostgreSQL (production) :
# DATABASE_URL=postgresql://user:password@host:5432/biwex_db

# ── WHATSAPP ─────────────────────────────────────────────────
# Numéro de téléphone pour les notifications de commande
# Format international sans le + (ex: 21654360846)
WHATSAPP_NUMBER=21654360846

# ── JENKINS (défini automatiquement par Jenkins) ─────────────
# BUILD_NUMBER  : numéro de build incrémenté automatiquement
# BRANCH_NAME   : nom de la branche (dev, main, feature/xxx)
# TAG_NAME      : nom du tag (v1.0.0) pour le pipeline versionné
# CHANGE_ID     : numéro de la PR pour le pipeline PR
# CHANGE_BRANCH : branche source de la PR
# CHANGE_TARGET : branche cible de la PR (doit être "dev")
