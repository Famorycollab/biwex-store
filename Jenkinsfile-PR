// ============================================================
//  PIPELINE 1 : BUILD & SMOKE SUR PULL REQUEST (PR)
//  Déclencheur : Ouverture ou mise à jour d'une PR vers "dev"
//  Objectif    : Valider que le code de la branche feature compile
//                et passe le smoke test avant fusion dans dev
// ============================================================

pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        DOCKER_BIN     = 'C:\\Users\\Famory Toure\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        IMAGE_NAME     = 'biwex-store'
        CONTAINER_NAME = "biwex-pr-test-${BUILD_NUMBER}"
        SMOKE_STATUS   = 'NOT_RUN'
    }

    stages {

        // ══════════════════════════════════════════════════════
        // STAGE 1 - CHECKOUT
        // ══════════════════════════════════════════════════════
        stage('1 - Checkout') {
            steps {
                echo '=== STAGE 1 : Checkout du code de la Pull Request ==='
                checkout scm
                script {
                    echo "PR ID         : ${env.CHANGE_ID ?: 'Manuelle/Test'}"
                    echo "Branche source: ${env.CHANGE_BRANCH ?: env.BRANCH_NAME ?: 'feature'}"
                    echo "Branche cible : ${env.CHANGE_TARGET ?: 'dev'}"
                }
            }
        }

        // ══════════════════════════════════════════════════════
        // STAGE 2 - SETUP & VALIDATION CIBLE
        // ══════════════════════════════════════════════════════
        stage('2 - Setup') {
            steps {
                echo '=== STAGE 2 : Validation de la Pull Request et setup ==='
                script {
                    // Si le build est déclenché par une vraie PR GitHub
                    if (env.CHANGE_ID) {
                        echo "[PR Check] Validation de la cible de la PR : #${env.CHANGE_ID}"
                        if (env.CHANGE_TARGET != 'dev') {
                            error("ERREUR CRITIQUE : La Pull Request cible '${env.CHANGE_TARGET}'. Elle DOIT obligatoirement cibler 'dev' !")
                        }
                        echo "[PR Check] Cible 'dev' conforme. Validation autorisee."
                    } else {
                        echo "[Info] Exécution manuelle ou test direct autorise."
                    }
                }

                bat '''
                    @echo off
                    echo [Setup] Verification des composants obligatoires...
                    if not exist app.py (
                        echo ERREUR : app.py manquant !
                        exit /b 1
                    )
                    if not exist requirements.txt (
                        echo ERREUR : requirements.txt manquant !
                        exit /b 1
                    )
                    if not exist Dockerfile (
                        echo ERREUR : Dockerfile manquant !
                        exit /b 1
                    )
                    if not exist scripts\\smoke_test.py (
                        echo ERREUR : scripts\\smoke_test.py manquant !
                        exit /b 1
                    )

                    if not exist artifacts mkdir artifacts
                    echo [Setup] Tous les composants sont presents.

                    echo [Docker] Verification du moteur Docker...
                    if exist "%DOCKER_BIN%" (
                        "%DOCKER_BIN%" version
                    ) else (
                        docker version
                    )
                '''
            }
        }

        // ══════════════════════════════════════════════════════
        // STAGE 3 - BUILD DOCKER
        // ══════════════════════════════════════════════════════
        stage('3 - Build Docker') {
            steps {
                echo '=== STAGE 3 : Construction de l image de test PR ==='
                bat '''
                    @echo off
                    set "DOCKER_CMD=%DOCKER_BIN%"
                    if not exist "%DOCKER_CMD%" set "DOCKER_CMD=docker"

                    echo [Build] Construction de %IMAGE_NAME%:pr-%BUILD_NUMBER%...
                    "%DOCKER_CMD%" build ^
                        --build-arg PYTHON_VERSION=3.11 ^
                        -t %IMAGE_NAME%:pr-%BUILD_NUMBER% ^
                        . > artifacts\\docker-build.log 2>&1

                    set "BUILD_EXIT=%ERRORLEVEL%"
                    type artifacts\\docker-build.log
                    exit /b %BUILD_EXIT%
                '''
            }
        }

        // ══════════════════════════════════════════════════════
        // STAGE 4 - RUN DOCKER
        // ══════════════════════════════════════════════════════
        stage('4 - Run Docker') {
            steps {
                echo '=== STAGE 4 : Démarrage du conteneur temporaire ==='
                bat '''
                    @echo off
                    set "DOCKER_CMD=%DOCKER_BIN%"
                    if not exist "%DOCKER_CMD%" set "DOCKER_CMD=docker"

                    echo [Run] Arret de tout ancien conteneur...
                    "%DOCKER_CMD%" rm -f %CONTAINER_NAME% 2>NUL

                    echo [Run] Lancement de %CONTAINER_NAME%...
                    "%DOCKER_CMD%" run -d ^
                        --name %CONTAINER_NAME% ^
                        -e SECRET_KEY=jenkins-pr-secret-key ^
                        %IMAGE_NAME%:pr-%BUILD_NUMBER%

                    if errorlevel 1 (
                        echo ERREUR : Echec du demarrage du conteneur.
                        exit /b 1
                    )

                    echo [Run] Conteneur operationnel.
                    "%DOCKER_CMD%" ps --filter name=%CONTAINER_NAME%
                '''
                sleep(time: 5, unit: 'SECONDS')
            }
        }

        // ══════════════════════════════════════════════════════
        // STAGE 5 - SMOKE TEST (Validation d'entrée)
        // ══════════════════════════════════════════════════════
        stage('5 - Smoke Test') {
            steps {
                echo '=== STAGE 5 : Smoke Test HTTP (Contrôle d acceptation) ==='
                script {
                    try {
                        retry(15) {
                            sleep(time: 2, unit: 'SECONDS')
                            bat '''
                                @echo off
                                set "DOCKER_CMD=%DOCKER_BIN%"
                                if not exist "%DOCKER_CMD%" set "DOCKER_CMD=docker"

                                "%DOCKER_CMD%" exec %CONTAINER_NAME% python /app/scripts/smoke_test.py http://127.0.0.1:5000/ > artifacts\\smoke-test.txt 2>&1
                                type artifacts\\smoke-test.txt
                            '''
                        }

                        env.SMOKE_STATUS = 'PASSED'
                        writeFile(file: 'artifacts/smoke-status.txt', text: 'PASSED')
                        echo '=== SMOKE TEST : PASSED ==='

                    } catch (err) {
                        env.SMOKE_STATUS = 'FAILED'
                        writeFile(file: 'artifacts/smoke-status.txt', text: 'FAILED')
                        echo '=== SMOKE TEST : FAILED ==='
                        throw err
                    }
                }
            }
        }

        // ══════════════════════════════════════════════════════
        // STAGE 6 - ARCHIVE ARTIFACTS
        // ══════════════════════════════════════════════════════
        stage('6 - Archive Artifacts') {
            steps {
                echo '=== STAGE 6 : Archivage des preuves d exécution ==='
                script {
                    def smokeResult = fileExists('artifacts/smoke-status.txt') ? readFile('artifacts/smoke-status.txt').trim() : 'UNKNOWN'

                    def report = """\
==============================================================
 RAPPORT DE VALIDATION PULL REQUEST - BIWEX STORE
==============================================================
Date d'execution : ${new Date().format('dd/MM/yyyy HH:mm:ss')}
Pipeline         : Biwex-Store-PR (Validation Pull Request)
Build Numero     : #${env.BUILD_NUMBER}
Pull Request     : #${env.CHANGE_ID ?: 'N/A'}
Branche Source   : ${env.CHANGE_BRANCH ?: env.BRANCH_NAME ?: 'feature'}
Branche Cible    : ${env.CHANGE_TARGET ?: 'dev'}
Auteur PR        : ${env.CHANGE_AUTHOR ?: 'N/A'}

IMAGE TESTEE :
  - ${env.IMAGE_NAME}:pr-${env.BUILD_NUMBER}

RESULTAT DES ETAPES :
  Stage 1 - Checkout        : PASSED
  Stage 2 - Setup & Cible   : PASSED
  Stage 3 - Build Docker    : PASSED
  Stage 4 - Run Docker      : PASSED
  Stage 5 - Smoke Test      : ${smokeResult}
  Stage 6 - Archive         : PASSED

DECISION AUTOMATIQUE :
  Fusion autorisee dans dev : ${smokeResult == 'PASSED' ? 'OUI (VALIDEE) [OK]' : 'NON (BLOQUEE) [ERREUR]'}

Binôme : Famory TOURE & Abdoul TRAORE
Projet DevOps 3LIG - ISG Sousse
==============================================================
"""
                    writeFile(file: 'artifacts/pipeline-report.txt', text: report)
                    echo report
                }

                archiveArtifacts(
                    artifacts: 'artifacts/**',
                    fingerprint: true,
                    allowEmptyArchive: true
                )
            }
        }
    }

    // ── POST ACTIONS : NETTOYAGE ────────────────────────────────
    post {
        always {
            echo '=== Nettoyage du conteneur et image temporaire PR ==='
            bat '''
                @echo off
                set "DOCKER_CMD=%DOCKER_BIN%"
                if not exist "%DOCKER_CMD%" set "DOCKER_CMD=docker"

                "%DOCKER_CMD%" rm -f %CONTAINER_NAME% 2>NUL
                "%DOCKER_CMD%" rmi %IMAGE_NAME%:pr-%BUILD_NUMBER% 2>NUL
                exit /b 0
            '''
        }
        success {
            echo 'BIWEX STORE [PR] : Validation reussie. Le merge vers dev est pret.'
        }
        failure {
            echo 'BIWEX STORE [PR] : Echec de validation de la PR. Consultez artifacts.'
        }
    }
}
